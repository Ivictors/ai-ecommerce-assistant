quarkus.datasource.db-kind=${DB_KIND:postgresql}
quarkus.datasource.username=${DB_USERNAME:value}
quarkus.datasource.password=${DB_PASSWORD:value}
quarkus.datasource.jdbc.url=${DB_URL:jdbc:postgresql://localhost:5432/value}
quarkus.flyway.migrate-at-start=true

quarkus.langchain4j.openai.api-key=${OPENAI_API_KEY:your key}
quarkus.langchain4j.openai.chat-model.model-name=gpt-4o-mini
quarkus.langchain4j.openai.chat-model.temperature=0.2

quarkus.langchain4j.chat-memory.type=message-window
quarkus.langchain4j.chat-memory.max-messages=10

mp.jwt.verify.publickey.location=
mp.jwt.verify.issuer=
quarkus.smallrye-jwt.enabled=true
smallrye.jwt.sign.key.location=${JWT_PRIVATE_KEY_LOCATION:privateKey.pem}
security.jwt.access-token-lifetime=${JWT_ACCESS_TOKEN_LIFETIME:PT15M}

security.password.argon2.memory-kib=${PASSWORD_ARGON2_MEMORY_KIB:65536}
security.password.argon2.iterations=${PASSWORD_ARGON2_ITERATIONS:3}
security.password.argon2.parallelism=${PASSWORD_ARGON2_PARALLELISM:1}
security.password.argon2.hash-length=${PASSWORD_ARGON2_HASH_LENGTH:32}
